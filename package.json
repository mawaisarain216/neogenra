{
  "name": "neogenra-experience",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit",
    "security": "npm audit --audit-level=high",
    "db:create-admin": "node scripts/create-admin.mjs",
    "db:seed-neogenra": "node scripts/seed-neogenra.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "npm run preflight && npm run typecheck && npm run lint && npm run build",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:seed": "node scripts/seed-neogenra.mjs",
    "db:studio": "prisma studio",
    "security:headers": "node scripts/check-security.mjs",
    "vercel-build": "prisma migrate deploy && prisma generate && next build"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "@prisma/client": "7.10.0",
    "bcryptjs": "latest",
    "zod": "latest",
    "@prisma/adapter-neon": "7.10.0",
    "@vercel/blob": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest",
    "tailwindcss": "latest",
    "@tailwindcss/postcss": "latest",
    "prisma": "7.10.0",
    "@types/bcryptjs": "latest",
    "dotenv": "latest"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10"
  }
}
